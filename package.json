{
  "name": "browser-engineering-js",
  "version": "1.0.0",
  "description": "JavaScript implementation of Web Browser Engineering book - A browser built with p5.js",
  "main": "src/app/index.html",
  "scripts": {
    "start": "npm run dev:all",
    "dev:app": "http-server src/app -p 8000 -c-1 --cors -o",
    "dev:proxy": "nodemon src/proxy/proxy-server.js",
    "dev:all": "concurrently \"npm run dev:app\" \"npm run dev:proxy\" --names \"APP,PROXY\" --prefix-colors \"blue,green\"",
    "serve": "http-server src/app -p 8000 -c-1 --cors",
    "proxy": "node src/proxy/proxy-server.js",
    "lint": "echo \"No linter configured yet\"",
    "test": "echo \"No tests configured yet\""
  },
  "keywords": [
    "browser",
    "browser-engineering",
    "p5js",
    "web-browser",
    "cors",
    "proxy",
    "javascript",
    "educational"
  ],
  "author": "fliklab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fliklab/browser-engineering-js.git"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "http-server": "^14.1.1",
    "concurrently": "^8.2.2"
  }
}
